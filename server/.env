PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave empty or set to local/Atlas. If unreachable, in-memory MongoDB will auto-boot)
MONGO_URI=mongodb://localhost:27017/cineverse

# JWT Authentication
JWT_SECRET=cineverse_super_secret_jwt_key_998877665544332211_xyz
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Lock Duration (in milliseconds, 10 minutes default)
SEAT_LOCK_DURATION_MS=600000

# Nodemailer / Email (Optional: Uses Ethereal test account if credentials not provided)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CineVerse Support <no-reply@cineverse.com>"

# Cloudinary (Optional: default mock image URLs used if unconfigured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Providers (Mock mode active by default)
PAYMENT_MODE=MOCK
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
